# Copy to terraform.tfvars and adjust. Real credentials never go in here -
# they come from the AWS CLI profile or the environment, and *.tfvars is
# gitignored.

region          = "eu-north-1"
aws_profile     = "campusdesk"
project         = "campusdesk"
cluster_version = "1.31"

# t3.small x2 is the cheapest pairing that runs the EKS system pods plus
# this application.
node_instance_type = "t3.small"
node_desired_size  = 2
