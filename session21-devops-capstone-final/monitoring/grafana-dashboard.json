{
  "title": "TaskBoard API",
  "uid": "taskboard-api",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "Requests per second by handler", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
     "targets": [{"expr": "sum by (handler) (rate(http_requests_total{namespace=\"taskboard\"}[1m]))", "legendFormat": "{{handler}}"}]},
    {"type": "timeseries", "title": "p95 latency (seconds)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{namespace=\"taskboard\"}[1m])))", "legendFormat": "{{handler}}"}]},
    {"type": "stat", "title": "5xx error rate", "gridPos": {"x": 0, "y": 9, "w": 6, "h": 6},
     "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"expr": "(sum(rate(http_requests_total{namespace=\"taskboard\",status=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{namespace=\"taskboard\"}[5m])), 1e-9)"}]},
    {"type": "stat", "title": "Backend pods scraped", "gridPos": {"x": 6, "y": 9, "w": 6, "h": 6},
     "targets": [{"expr": "count(up{namespace=\"taskboard\",service=~\".*backend\"} == 1)"}]},
    {"type": "timeseries", "title": "Backend CPU (cores) per pod", "gridPos": {"x": 12, "y": 9, "w": 12, "h": 6},
     "targets": [{"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"taskboard\",container=\"backend\"}[1m]))", "legendFormat": "{{pod}}"}]}
  ]
}
